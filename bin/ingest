#!/usr/bin/env bash
# bin/ingest — one-command wrapper around the specimen ingestion pipeline.
#
# Runs the CC0 iNaturalist → BiRefNet cutout → GBIF → store pipeline locally.
# Defaults to your DEV database + the review queue, so it's safe to experiment.
#
# Single species:
#   bin/ingest "Danaus plexippus"                 # dev, LIMIT=25, review queue
#   bin/ingest "Danaus plexippus" 10              # dev, LIMIT=10
#   bin/ingest "Danaus plexippus" 10 --dry-run    # preview only (no downloads/writes)
#   bin/ingest "Danaus plexippus" 5  --prod       # LIVE site (needs .env.ingest)
#
# Batch (rotating pool from config/ingest_species.txt — 5 species x 5 each):
#   bin/ingest --batch --dry-run                  # preview the batch
#   bin/ingest --batch                            # into DEV
#   bin/ingest --batch --prod                     # into the LIVE site
#   PER_SPECIES=10 SPECIES_PER_RUN=8 bin/ingest --batch --prod
#
# Flags:
#   --batch     process a rotating set of species from config/ingest_species.txt
#   --prod      write to the LIVE production DB + storage (reads .env.ingest)
#   --dry-run   only list candidate photos; download/save nothing
#   --publish   auto-publish strong GBIF matches (default: everything → review)
#   --yes, -y   skip the production confirmation prompt
set -euo pipefail

cd "$(dirname "$0")/.."

BATCH=0
PROD=0
DRY_RUN=0
PUBLISH=0
ASSUME_YES=0
POSITIONAL=()

for arg in "$@"; do
  case "$arg" in
    --batch)     BATCH=1 ;;
    --prod)      PROD=1 ;;
    --dry-run)   DRY_RUN=1 ;;
    --publish)   PUBLISH=1 ;;
    --yes|-y)    ASSUME_YES=1 ;;
    -*)          echo "unknown flag: $arg" >&2; exit 1 ;;
    *)           POSITIONAL+=("$arg") ;;
  esac
done

# Resolve what we're ingesting.
if [ "$BATCH" -eq 1 ]; then
  DESC="batch (config/ingest_species.txt)"
else
  TAXON="${POSITIONAL[0]:-}"
  if [ -z "$TAXON" ]; then
    echo "usage: bin/ingest \"Scientific name\" [LIMIT] [--prod] [--dry-run] [--publish]" >&2
    echo "   or: bin/ingest --batch [--prod] [--dry-run] [--publish]" >&2
    exit 1
  fi
  LIMIT="${POSITIONAL[1]:-25}"
  case "$LIMIT" in
    ''|*[!0-9]*) echo "LIMIT must be a number, got: $LIMIT" >&2; exit 1 ;;
  esac
  DESC="taxon=\"${TAXON}\" limit=${LIMIT}"
fi

# Locate the rembg binary (not needed for a dry run).
if [ -z "${REMBG_BIN:-}" ]; then
  if command -v rembg >/dev/null 2>&1; then
    REMBG_BIN="$(command -v rembg)"
  elif [ -x "$HOME/.local/bin/rembg" ]; then
    REMBG_BIN="$HOME/.local/bin/rembg"
  fi
fi
export REMBG_BIN

TARGET="DEV database"
if [ "$PROD" -eq 1 ]; then
  if [ ! -f ".env.ingest" ]; then
    echo "Missing .env.ingest — copy the template first:" >&2
    echo "    cp .env.ingest.example .env.ingest   # then fill in your live creds" >&2
    exit 1
  fi
  # Load .env.ingest line by line (do NOT `source` it — values like DATABASE_URL
  # contain `&`/`?` which the shell would mis-parse). This reads each KEY=value
  # literally, so raw pasted values work without quoting.
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in
      ''|\#*) continue ;;            # skip blanks and comments
      *=*)    export "${line%%=*}=${line#*=}" ;;
    esac
  done < .env.ingest
  export RAILS_ENV=production
  TARGET="PRODUCTION (live site)"
fi

echo "Ingest → ${TARGET} | ${DESC} dry_run=${DRY_RUN} publish=${PUBLISH}"

# Guard rail: confirm before writing to the live site.
if [ "$PROD" -eq 1 ] && [ "$ASSUME_YES" -ne 1 ] && [ "$DRY_RUN" -ne 1 ]; then
  printf 'This writes to the LIVE site. Type "yes" to continue: '
  read -r reply
  if [ "$reply" != "yes" ]; then
    echo "Aborted."
    exit 1
  fi
fi

if [ "$BATCH" -eq 1 ]; then
  exec env DRY_RUN="$DRY_RUN" PUBLISH="$PUBLISH" bin/rails specimen:ingest_batch
else
  exec env TAXON="$TAXON" LIMIT="$LIMIT" DRY_RUN="$DRY_RUN" PUBLISH="$PUBLISH" bin/rails specimen:ingest
fi
