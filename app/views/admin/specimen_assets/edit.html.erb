<div class="w-full max-w-2xl mx-auto pt-4 md:pt-0"
     data-controller="image-resize"
     <% if @specimen_asset.image.attached? %>data-image-resize-url-value="<%= rails_storage_proxy_path(@specimen_asset.image) %>"<% end %>>
  <div class="mb-6">
    <%= link_to "← Back to queue", admin_specimen_assets_path, class: "text-sm text-stone-500 dark:text-stone-400 hover:text-amber-600 dark:hover:text-amber-500" %>
  </div>

  <h1 class="font-serif text-3xl text-stone-900 dark:text-stone-100 mb-2">Edit Specimen</h1>
  <p class="text-stone-600 dark:text-stone-400 mb-8">Review and update specimen details before approval.</p>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
    <!-- Image preview -->
    <div class="md:col-span-1">
      <div class="sticky top-24">
        <!-- Static preview -->
        <div data-image-resize-target="staticPreview">
          <div class="aspect-square bg-gradient-to-br from-stone-100 to-stone-200 dark:from-stone-700 dark:to-stone-800 rounded-2xl overflow-hidden mb-3">
            <% if @specimen_asset.image.attached? %>
              <%= image_tag @specimen_asset.image,
                alt: @specimen_asset.display_name,
                class: "w-full h-full object-contain p-4" %>
            <% end %>
          </div>
        </div>

        <% if @specimen_asset.image.attached? %>
          <!-- Resize / reframe editor (mirrors the upload-page cutout editor) -->
          <div data-image-resize-target="editor" class="hidden space-y-3 mb-3">
            <div class="aspect-square bg-gradient-to-br from-stone-100 to-stone-200 dark:from-stone-700 dark:to-stone-600 rounded-2xl p-3 flex items-center justify-center">
              <canvas data-image-resize-target="canvas" class="max-w-full max-h-[320px] object-contain"></canvas>
            </div>

            <div class="p-3 bg-stone-50 dark:bg-stone-800/50 border border-stone-200 dark:border-stone-700 rounded-xl space-y-3">
              <div class="flex items-center justify-between">
                <p class="text-xs font-medium text-stone-500 dark:text-stone-400 uppercase tracking-wide">Adjust Image</p>
                <p class="text-[10px] text-stone-400 dark:text-stone-500 italic">Drag image to reposition</p>
              </div>

              <div class="flex items-center gap-3">
                <label class="text-xs text-stone-600 dark:text-stone-400 w-10 flex-shrink-0">Size</label>
                <input type="range" min="25" max="200" value="100" step="5"
                       data-image-resize-target="zoomSlider"
                       data-action="input->image-resize#adjustZoom"
                       class="flex-grow h-1.5 bg-stone-200 dark:bg-stone-600 rounded-full appearance-none cursor-pointer accent-amber-600">
                <span data-image-resize-target="zoomValue" class="text-xs text-stone-500 dark:text-stone-400 w-10 text-right">100%</span>
              </div>

              <div class="flex items-center gap-3">
                <label class="text-xs text-stone-600 dark:text-stone-400 w-10 flex-shrink-0 flex items-center gap-1" title="Horizontal position">
                  <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h8m-8 0l3-3m-3 3l3 3m5-3l-3-3m3 3l-3 3"/></svg>
                  X
                </label>
                <input type="range" min="-100" max="100" value="0" step="1"
                       data-image-resize-target="panXSlider"
                       data-action="input->image-resize#adjustPanX"
                       class="flex-grow h-1.5 bg-stone-200 dark:bg-stone-600 rounded-full appearance-none cursor-pointer accent-amber-600">
                <span data-image-resize-target="panXValue" class="text-xs text-stone-500 dark:text-stone-400 w-10 text-right tabular-nums">0</span>
              </div>

              <div class="flex items-center gap-3">
                <label class="text-xs text-stone-600 dark:text-stone-400 w-10 flex-shrink-0 flex items-center gap-1" title="Vertical position">
                  <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v8m0-8l-3 3m3-3l3 3m-3 5l-3-3m3 3l3-3"/></svg>
                  Y
                </label>
                <input type="range" min="-100" max="100" value="0" step="1"
                       data-image-resize-target="panYSlider"
                       data-action="input->image-resize#adjustPanY"
                       class="flex-grow h-1.5 bg-stone-200 dark:bg-stone-600 rounded-full appearance-none cursor-pointer accent-amber-600">
                <span data-image-resize-target="panYValue" class="text-xs text-stone-500 dark:text-stone-400 w-10 text-right tabular-nums">0</span>
              </div>

              <div class="flex items-center gap-2 pt-1 flex-wrap">
                <button type="button" data-action="click->image-resize#autoTrim"
                        class="px-3 py-1.5 text-xs font-medium bg-white dark:bg-stone-700 border border-stone-300 dark:border-stone-600 text-stone-600 dark:text-stone-300 rounded-full hover:bg-stone-100 dark:hover:bg-stone-600 transition-colors">
                  Auto-trim
                </button>
                <button type="button" data-action="click->image-resize#rotate"
                        class="px-3 py-1.5 text-xs font-medium bg-white dark:bg-stone-700 border border-stone-300 dark:border-stone-600 text-stone-600 dark:text-stone-300 rounded-full hover:bg-stone-100 dark:hover:bg-stone-600 transition-colors inline-flex items-center gap-1">
                  <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
                  Rotate 90°
                </button>
                <button type="button" data-action="click->image-resize#recenter"
                        class="px-3 py-1.5 text-xs font-medium bg-white dark:bg-stone-700 border border-stone-300 dark:border-stone-600 text-stone-600 dark:text-stone-300 rounded-full hover:bg-stone-100 dark:hover:bg-stone-600 transition-colors inline-flex items-center gap-1">
                  <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v8m-4-4h8M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                  Recenter
                </button>
                <button type="button" data-action="click->image-resize#resetEdits"
                        class="px-3 py-1.5 text-xs font-medium text-stone-500 dark:text-stone-400 hover:text-stone-700 dark:hover:text-stone-200 transition-colors">
                  Reset
                </button>
                <span data-image-resize-target="statusMsg"
                      class="hidden text-xs text-emerald-600 dark:text-emerald-400 ml-auto transition-opacity duration-300 opacity-0"></span>
              </div>
            </div>
          </div>

          <button type="button"
                  data-image-resize-target="toggleButton"
                  data-action="click->image-resize#toggle"
                  class="w-full mb-2 px-4 py-2 text-sm font-medium bg-white dark:bg-stone-800 border border-stone-300 dark:border-stone-600 text-stone-700 dark:text-stone-300 rounded-full hover:bg-stone-50 dark:hover:bg-stone-700 transition-colors inline-flex items-center justify-center gap-2">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4"/></svg>
            Resize / reframe image
          </button>
          <p class="text-[11px] text-stone-400 dark:text-stone-500 mb-4">Outputs a square transparent PNG. Save the form to apply.</p>
        <% end %>

        <div class="space-y-2 text-sm text-stone-500 dark:text-stone-400">
          <p>Submitted <%= time_ago_in_words(@specimen_asset.created_at) %> ago</p>
          <% if @specimen_asset.bg_removed? %>
            <p class="flex items-center gap-1.5">
              <span class="w-2 h-2 rounded-full bg-violet-500"></span>
              Background removed<%= @specimen_asset.imported? ? " (BiRefNet)" : " via Cloudinary" %>
            </p>
          <% end %>
          <% if @specimen_asset.submitter_email.present? %>
            <p class="flex items-center gap-1.5">
              <span class="w-2 h-2 rounded-full bg-amber-500"></span>
              <a href="mailto:<%= @specimen_asset.submitter_email %>" class="text-amber-600 dark:text-amber-400 hover:underline"><%= @specimen_asset.submitter_email %></a>
            </p>
          <% end %>
          <% if @specimen_asset.attribution_name.present? %>
            <p>By: <%= @specimen_asset.attribution_name %></p>
          <% end %>
        </div>

        <!-- Import provenance (ADMIN-ONLY — never rendered on public pages) -->
        <% if @specimen_asset.imported? %>
          <% prov = @specimen_asset.import_provenance %>
          <div class="mt-4 p-3 bg-sky-50 dark:bg-sky-900/20 border border-sky-200 dark:border-sky-800 rounded-xl space-y-1.5 text-xs">
            <p class="font-medium text-sky-800 dark:text-sky-300 uppercase tracking-wide flex items-center gap-1.5">
              <span class="w-2 h-2 rounded-full bg-sky-500"></span>
              Import source · admin only
            </p>
            <p class="text-stone-600 dark:text-stone-400">Source: <%= prov["import_source"].to_s.titleize %></p>
            <% if prov["source_url"].present? %>
              <p>
                <%= link_to "View original observation ↗", prov["source_url"],
                  target: "_blank", rel: "noopener noreferrer nofollow",
                  class: "text-sky-600 dark:text-sky-400 hover:underline break-all" %>
              </p>
            <% end %>
            <% if prov["observer"].present? %>
              <p class="text-stone-600 dark:text-stone-400">Observer: <%= prov["observer"] %></p>
            <% end %>
            <% if prov["photo_license"].present? %>
              <p class="text-stone-600 dark:text-stone-400">Photo license: <%= prov["photo_license"].to_s.upcase %></p>
            <% end %>
            <% if prov["photo_attribution"].present? %>
              <p class="text-stone-500 dark:text-stone-400 italic"><%= prov["photo_attribution"] %></p>
            <% end %>
            <% if @specimen_asset.qc_reasons.any? %>
              <p class="text-amber-600 dark:text-amber-400 font-medium">
                QC flags: <%= @specimen_asset.qc_reasons.join(", ") %>
                <% if prov["opaque_ratio"] %>
                  <span class="text-stone-400 dark:text-stone-500 font-normal">(opaque <%= (prov["opaque_ratio"].to_f * 100).round(1) %>%, blobs <%= prov["subject_blobs"] %>)</span>
                <% end %>
              </p>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>

    <!-- Edit form -->
    <div class="md:col-span-2">
      <% if @specimen_asset.errors.any? %>
        <div class="mb-6 p-4 bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 rounded-xl">
          <h3 class="text-red-800 dark:text-red-300 font-semibold mb-2">Please fix the following errors:</h3>
          <ul class="list-disc list-inside text-sm text-red-700 dark:text-red-400 space-y-1">
            <% @specimen_asset.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <%= form_with model: [:admin, @specimen_asset], class: "space-y-6", html: { multipart: true }, data: { controller: "taxon-autocomplete license", taxon_autocomplete_url_value: suggest_taxa_path } do |f| %>
        <%= f.file_field :image, accept: "image/png", class: "hidden", data: { image_resize_target: "fileField" } %>

        <!-- Specimen name (required display name) -->
        <div>
          <%= f.label :specimen_name, "Specimen name", class: "block text-sm font-medium text-stone-700 dark:text-stone-300 mb-2" %>
          <%= f.text_field :specimen_name,
            placeholder: "e.g., Bismuth / Quartz / Apis mellifera",
            required: true,
            class: "w-full px-4 py-3 bg-white dark:bg-stone-800 border border-stone-300 dark:border-stone-600 rounded-xl text-stone-800 dark:text-stone-200 placeholder:text-stone-400 dark:placeholder:text-stone-500 focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-transparent" %>
          <p class="mt-1 text-xs text-stone-500 dark:text-stone-400">
            Primary display name for this specimen.
          </p>
        </div>

        <!-- Scientific/taxonomic name with autocomplete (optional) -->
        <div>
          <label class="block text-sm font-medium text-stone-700 dark:text-stone-300 mb-2">Scientific / taxonomic name <span class="text-stone-400 dark:text-stone-500 font-normal">(optional)</span></label>
          <div class="relative">
            <%= text_field_tag "specimen_asset[scientific_name]",
              @specimen_asset.taxon&.scientific_name,
              placeholder: "e.g., Apis mellifera",
              autocomplete: "off",
              data: {
                taxon_autocomplete_target: "input",
                action: "input->taxon-autocomplete#onInput keydown->taxon-autocomplete#onKeydown blur->taxon-autocomplete#onBlur"
              },
              class: "w-full px-4 py-3 bg-white dark:bg-stone-800 border border-stone-300 dark:border-stone-600 rounded-xl text-stone-800 dark:text-stone-200 placeholder:text-stone-400 dark:placeholder:text-stone-500 focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-transparent" %>
            
            <div data-taxon-autocomplete-target="results"
                 class="hidden absolute z-50 left-0 right-0 mt-1 bg-white dark:bg-stone-800 border border-stone-300 dark:border-stone-600 rounded-xl shadow-lg max-h-64 overflow-y-auto">
            </div>
          </div>
          <p class="mt-1 text-xs text-stone-500 dark:text-stone-400">
            Start typing to search GBIF taxonomy. Changing this will update the taxon association.
          </p>
          
          <% if @specimen_asset.taxon&.gbif_key.present? %>
            <p class="mt-2 text-xs text-emerald-600 dark:text-emerald-400">
              ✓ Currently matched: <%= @specimen_asset.taxon.gbif_canonical_name %> 
              (<%= @specimen_asset.taxon.gbif_rank&.downcase %>)
            </p>
          <% elsif @specimen_asset.taxon&.scientific_name.present? && @specimen_asset.taxon.scientific_name != @specimen_asset.specimen_name %>
            <p class="mt-2 text-xs text-amber-600 dark:text-amber-400">
              ⚠ Not verified in GBIF
            </p>
          <% end %>
        </div>

        <!-- Specimen Type (Group) -->
        <div>
          <label class="block text-sm font-medium text-stone-700 dark:text-stone-300 mb-2">Specimen Type</label>
          <%= select_tag "specimen_asset[taxon_group]",
            options_for_select(
              TaxonGroupResolver.all_with_metadata.map { |g| ["#{g[:icon]} #{g[:name]}", g[:value]] },
              @specimen_asset.taxon&.group
            ),
            class: "w-full px-4 py-3 bg-white dark:bg-stone-800 border border-stone-300 dark:border-stone-600 rounded-xl text-stone-800 dark:text-stone-200 focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-transparent" %>
          <p class="mt-1 text-xs text-stone-500 dark:text-stone-400">
            <% if @specimen_asset.taxon&.gbif_key.present? %>
              Auto-detected from GBIF. Override if incorrect.
            <% else %>
              Manually assign a specimen type.
            <% end %>
          </p>
        </div>

        <!-- Common name -->
        <div>
          <%= f.label :common_name, class: "block text-sm font-medium text-stone-700 dark:text-stone-300 mb-2" %>
          <%= f.text_field :common_name,
            placeholder: "e.g., Great White Shark",
            class: "w-full px-4 py-3 bg-white dark:bg-stone-800 border border-stone-300 dark:border-stone-600 rounded-xl text-stone-800 dark:text-stone-200 placeholder:text-stone-400 dark:placeholder:text-stone-500 focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-transparent" %>
        </div>

        <!-- Specimen Traits -->
        <details class="group" <%= @specimen_asset.sex.present? || @specimen_asset.life_stage.present? || @specimen_asset.region.present? ? "open" : "" %>>
          <summary class="cursor-pointer text-sm font-medium text-amber-600 dark:text-amber-500 hover:underline flex items-center gap-1">
            <svg class="w-4 h-4 transition-transform group-open:rotate-90" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
            Specimen traits (sex, life stage, view, location…)
          </summary>

          <div class="mt-4 space-y-4 p-4 bg-stone-50 dark:bg-stone-800/50 rounded-xl border border-stone-200 dark:border-stone-700">
            <!-- Row 1: Sex + Life Stage -->
            <div class="grid grid-cols-2 gap-4">
              <div>
                <%= f.label :sex, class: "block text-sm font-medium text-stone-700 dark:text-stone-300 mb-2" %>
                <%= f.select :sex,
                  options_for_select([["Not specified", ""]] + SpecimenAsset::SEXES.map { |s| [s.titleize, s] }, @specimen_asset.sex),
                  {},
                  class: "w-full px-3 py-2 bg-white dark:bg-stone-700 border border-stone-300 dark:border-stone-600 rounded-lg text-stone-800 dark:text-stone-200 text-sm" %>
              </div>
              <div>
                <%= f.label :life_stage, "Life stage", class: "block text-sm font-medium text-stone-700 dark:text-stone-300 mb-2" %>
                <%= f.select :life_stage,
                  options_for_select([["Not specified", ""]] + SpecimenAsset::LIFE_STAGES.map { |s| [s.titleize, s] }, @specimen_asset.life_stage),
                  {},
                  class: "w-full px-3 py-2 bg-white dark:bg-stone-700 border border-stone-300 dark:border-stone-600 rounded-lg text-stone-800 dark:text-stone-200 text-sm" %>
              </div>
            </div>

            <!-- Row 2: View + Part -->
            <div class="grid grid-cols-2 gap-4">
              <div>
                <%= f.label :view, "View angle", class: "block text-sm font-medium text-stone-700 dark:text-stone-300 mb-2" %>
                <%= f.select :view,
                  options_for_select([["Not specified", ""]] + SpecimenAsset::VIEWS.map { |s| [s.titleize, s] }, @specimen_asset.view),
                  {},
                  class: "w-full px-3 py-2 bg-white dark:bg-stone-700 border border-stone-300 dark:border-stone-600 rounded-lg text-stone-800 dark:text-stone-200 text-sm" %>
              </div>
              <div>
                <%= f.label :part, "Part shown", class: "block text-sm font-medium text-stone-700 dark:text-stone-300 mb-2" %>
                <%= f.select :part,
                  options_for_select([["Not specified", ""]] + SpecimenAsset::PARTS.map { |s| [s.titleize, s] }, @specimen_asset.part),
                  {},
                  class: "w-full px-3 py-2 bg-white dark:bg-stone-700 border border-stone-300 dark:border-stone-600 rounded-lg text-stone-800 dark:text-stone-200 text-sm" %>
              </div>
            </div>

            <!-- Morph -->
            <div>
              <%= f.label :morph, "Morph / variant", class: "block text-sm font-medium text-stone-700 dark:text-stone-300 mb-2" %>
              <%= f.text_field :morph,
                placeholder: "e.g., winter plumage, albino, blue form",
                class: "w-full px-3 py-2 bg-white dark:bg-stone-700 border border-stone-300 dark:border-stone-600 rounded-lg text-stone-800 dark:text-stone-200 placeholder:text-stone-400 text-sm" %>
            </div>

            <!-- Region -->
            <div>
              <%= f.label :region, "Location observed", class: "block text-sm font-medium text-stone-700 dark:text-stone-300 mb-2" %>
              <%= f.text_field :region,
                placeholder: "e.g., California, USA",
                class: "w-full px-3 py-2 bg-white dark:bg-stone-700 border border-stone-300 dark:border-stone-600 rounded-lg text-stone-800 dark:text-stone-200 placeholder:text-stone-400 text-sm" %>
            </div>

            <!-- Notes -->
            <div>
              <%= f.label :notes, class: "block text-sm font-medium text-stone-700 dark:text-stone-300 mb-2" %>
              <%= f.text_area :notes,
                placeholder: "Any additional context about this specimen...",
                rows: 2,
                class: "w-full px-3 py-2 bg-white dark:bg-stone-700 border border-stone-300 dark:border-stone-600 rounded-lg text-stone-800 dark:text-stone-200 placeholder:text-stone-400 text-sm resize-none" %>
            </div>
          </div>
        </details>

        <!-- License -->
        <div>
          <%= f.label :license, class: "block text-sm font-medium text-stone-700 dark:text-stone-300 mb-2" %>
          <%= f.select :license,
            [["CC0 (Public Domain)", "CC0"], ["CC-BY (Attribution Required)", "CC_BY"]],
            {},
            class: "w-full px-4 py-3 bg-white dark:bg-stone-800 border border-stone-300 dark:border-stone-600 rounded-xl text-stone-800 dark:text-stone-200 focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-transparent",
            data: { action: "change->license#toggle", license_target: "select" } %>
        </div>

        <!-- Attribution (for CC-BY) -->
        <div data-license-target="attribution" class="<%= 'hidden' unless @specimen_asset.license == 'CC_BY' %> space-y-4 p-4 bg-amber-50 dark:bg-amber-900/20 border border-amber-200 dark:border-amber-800 rounded-xl">
          <p class="text-sm text-amber-800 dark:text-amber-300">CC-BY requires attribution information:</p>
          
          <div>
            <%= f.label :attribution_name, "Your Name / Organization", class: "block text-sm font-medium text-stone-700 dark:text-stone-300 mb-2" %>
            <%= f.text_field :attribution_name,
              placeholder: "e.g., Jane Doe",
              class: "w-full px-4 py-3 bg-white dark:bg-stone-800 border border-stone-300 dark:border-stone-600 rounded-xl text-stone-800 dark:text-stone-200 placeholder:text-stone-400 dark:placeholder:text-stone-500 focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-transparent" %>
          </div>

          <div>
            <%= f.label :attribution_url, "Attribution URL", class: "block text-sm font-medium text-stone-700 dark:text-stone-300 mb-2" %>
            <%= f.url_field :attribution_url,
              placeholder: "https://...",
              class: "w-full px-4 py-3 bg-white dark:bg-stone-800 border border-stone-300 dark:border-stone-600 rounded-xl text-stone-800 dark:text-stone-200 placeholder:text-stone-400 dark:placeholder:text-stone-500 focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-transparent" %>
          </div>
        </div>

        <!-- Status -->
        <div>
          <%= f.label :status, class: "block text-sm font-medium text-stone-700 dark:text-stone-300 mb-2" %>
          <%= f.select :status,
            [["Pending", "pending"], ["Approved", "approved"], ["Rejected", "rejected"]],
            {},
            class: "w-full px-4 py-3 bg-white dark:bg-stone-800 border border-stone-300 dark:border-stone-600 rounded-xl text-stone-800 dark:text-stone-200 focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-transparent" %>
        </div>

        <!-- Needs review flag -->
        <div class="flex items-center gap-3">
          <%= f.check_box :needs_review,
            class: "w-4 h-4 text-amber-600 border-stone-300 dark:border-stone-600 rounded focus:ring-amber-500" %>
          <%= f.label :needs_review, "Flag for additional review", class: "text-sm text-stone-700 dark:text-stone-300" %>
        </div>

        <!-- Actions -->
        <div class="flex items-center gap-4 pt-4 border-t border-stone-200 dark:border-stone-700">
          <%= f.submit "Save Changes",
            class: "px-6 py-3 bg-amber-600 text-white font-medium rounded-full hover:bg-amber-700 focus:outline-none focus:ring-2 focus:ring-amber-500 focus:ring-offset-2 dark:focus:ring-offset-stone-900 transition-colors cursor-pointer" %>
          
          <%= link_to "Cancel", admin_specimen_assets_path,
            class: "px-6 py-3 text-stone-600 dark:text-stone-400 font-medium hover:text-stone-800 dark:hover:text-stone-200 transition-colors" %>
        </div>
      <% end %>

      <!-- Quick actions -->
      <div class="mt-8 pt-6 border-t border-stone-200 dark:border-stone-700">
        <h3 class="text-sm font-medium text-stone-700 dark:text-stone-300 mb-4">Quick Actions</h3>
        <div class="flex items-center gap-3">
          <%= button_to admin_specimen_asset_path(@specimen_asset, status: "approved"),
            method: :patch,
            class: "px-4 py-2 bg-emerald-600 text-white text-sm font-medium rounded-full hover:bg-emerald-700 transition-colors" do %>
            ✓ Approve
          <% end %>

          <%= button_to admin_specimen_asset_path(@specimen_asset),
            method: :delete,
            data: { turbo_confirm: "Reject and delete this specimen?" },
            class: "px-4 py-2 bg-red-100 dark:bg-red-900/30 text-red-700 dark:text-red-400 text-sm font-medium rounded-full hover:bg-red-200 dark:hover:bg-red-900/50 transition-colors" do %>
            ✗ Reject & Delete
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>

