# .env.ingest.example — template for running the ingestion pipeline against the
# LIVE site. Copy this to `.env.ingest` (which is gitignored and NEVER committed)
# and fill in your real values:
#
#   cp .env.ingest.example .env.ingest
#
# Then run:  bin/ingest "Danaus plexippus" 5 --prod
#
# Easiest way to get every value at once — read them straight off the running
# production machine (run this yourself; do NOT share the output with anyone):
#
#   fly ssh console -a specimen-gallery -C "env" | \
#     grep -E '^(DATABASE_URL|AWS_ACCESS_KEY_ID|AWS_SECRET_ACCESS_KEY|AWS_ENDPOINT_URL_S3|AWS_REGION|BUCKET_NAME)='
#
# Then paste the KEY=value lines below, REPLACING the empty ones.
# IMPORTANT: paste the values raw, exactly as printed — do NOT add quotes.

DATABASE_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=
BUCKET_NAME=
